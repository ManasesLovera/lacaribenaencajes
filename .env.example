# development (default) uses local SQLite; production uses Neon Postgres.
ENVIRONMENT=development
LOCAL_DATABASE_URL=sqlite:///./lacaribena.db

CORS_ORIGINS=http://localhost:5173
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production only.
# DATABASE_URL should use a scoped read_write role, never the database owner.
# DATABASE_URL_UNPOOLED is the owner/direct URL, used only for migrations.
# DATABASE_URL=postgresql://app_role:password@host-pooler/db?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://owner:password@host/db?sslmode=require
#
# Production requires explicit HTTPS origins and rejects wildcards.
# CORS_ORIGINS=https://your-app.vercel.app

# Optional local Postgres from docker-compose.yml.
POSTGRES_DB=lacaribena
POSTGRES_USER=lacaribena
POSTGRES_PASSWORD=lacaribena
POSTGRES_PORT=5432
