# development (default) uses local SQLite; production uses Neon Postgres.
ENVIRONMENT=development
LOCAL_DATABASE_URL=sqlite:///./lacaribena.db

CORS_ORIGINS=http://localhost:5173
SECRET_KEY=lacaribena-dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Production only. `neon deploy` / `neon env pull` writes these.
# DATABASE_URL=postgresql://user:password@host-pooler/db?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# Optional local Postgres from docker-compose.yml.
POSTGRES_DB=lacaribena
POSTGRES_USER=lacaribena
POSTGRES_PASSWORD=lacaribena
POSTGRES_PORT=5432
